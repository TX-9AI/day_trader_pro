[Unit]
Description=feed triage every 60 s, 09:14-16:00 ET on weekdays (holidays and half days: refused by the script)

[Timer]
OnCalendar=Mon-Fri *-*-* 09:14..59:00 America/New_York
OnCalendar=Mon-Fri *-*-* 10..15:*:00 America/New_York
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
