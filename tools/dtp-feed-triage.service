[Unit]
Description=day_trader_pro feed triage (dxlink slot priority; dtp r521 / FEED.14) - NOT INSTALLED BY THE LAND
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/day_trader_pro
# --dry-run until the operator has read a day of its decisions; remove it to let it act.
ExecStart=/home/ubuntu/day_trader_pro/venv/bin/python /home/ubuntu/day_trader_pro/tools/feed_triage.py --dry-run
TimeoutStartSec=50
