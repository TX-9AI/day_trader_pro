[Unit]
Description=morning check at 09:19, 09:50 and 11:10 ET on weekdays (holidays: refused by the script) (dtp r539 / TIMER.1)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:19:00 America/New_York
OnCalendar=Mon..Fri *-*-* 09:50:00 America/New_York
OnCalendar=Mon..Fri *-*-* 11:10:00 America/New_York
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
