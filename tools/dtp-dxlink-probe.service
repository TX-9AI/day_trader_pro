[Unit]
Description=day_trader_pro dxlink node probe from control (no session, no credentials; dtp r521 / FEED.14) - NOT INSTALLED BY THE LAND
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/day_trader_pro
ExecStart=/home/ubuntu/day_trader_pro/venv/bin/python /home/ubuntu/day_trader_pro/tools/dxlink_probe.py
TimeoutStartSec=50
