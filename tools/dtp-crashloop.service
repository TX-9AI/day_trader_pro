[Unit]
Description=day_trader_pro crash-loop sentinel (fleet optionsbot restart watch)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/day_trader_pro
EnvironmentFile=/home/ubuntu/day_trader_pro/.env
ExecStart=/home/ubuntu/day_trader_pro/venv/bin/python /home/ubuntu/day_trader_pro/crashloop_sentinel.py
