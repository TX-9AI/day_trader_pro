[Unit]
Description=daily recap PDF: 17:00 ET weekdays, after the nightly review (dtp r569 / RECAP.1)

[Timer]
OnCalendar=Mon..Fri *-*-* 17:00:00 America/New_York
AccuracySec=30s
# A fire missed while control was down runs at the next boot; the script recaps today only, so a weekend or holiday
# boot skips and a missed day is rebuilt by hand (bash tools/daily_recap.sh --day YYYY-MM-DD).
Persistent=true

[Install]
WantedBy=timers.target
