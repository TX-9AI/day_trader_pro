[Unit]
Description=day_trader_pro 15:35 held-contracts page: each running box's open options read-only, one page for the tastytrade desk message (dtp r573 / HELD.1; installed by tools/install_held_page.sh)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/day_trader_pro
# Telegram names for the direct fallback when the router is down (the same file dtp-morning-check loads; never printed).
EnvironmentFile=/home/ubuntu/day_trader_pro/.env
# Reads ~/options-trader/trades.db ?mode=ro on each box; never places, cancels or modifies anything, never the broker.
ExecStart=/home/ubuntu/day_trader_pro/venv/bin/python /home/ubuntu/day_trader_pro/tools/held_contracts_page.py
TimeoutStartSec=120
MemoryMax=400M
